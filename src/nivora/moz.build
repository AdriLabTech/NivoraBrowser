# Pure modules (no Firefox globals) are plain .mjs files so they can also be
# unit tested under Node; modules that use Firefox APIs are .sys.mjs.
EXTRA_JS_MODULES.nivora += [
    "modules/NivoraCommands.sys.mjs",
    "modules/NivoraCommandsCore.mjs",
    "modules/NivoraL10n.sys.mjs",
    "modules/NivoraSettings.sys.mjs",
    "modules/NivoraSettingsCore.mjs",
    "modules/NivoraTabsCore.mjs",
]

DIRS += [
    "tests",
]
